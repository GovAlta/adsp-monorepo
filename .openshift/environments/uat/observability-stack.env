# Applied by .github/workflows/observability.yml; see ../../observability/README.md.
# Observed <10m CPU per component. Memory is unchanged: Prometheus has OOMKilled at
# 2Gi and the collector limit is paired with memory_limiter.limit_mib.
COLLECTOR_CPU_REQUEST=20m
COLLECTOR_CPU_LIMIT=200m
PROMETHEUS_CPU_REQUEST=50m
PROMETHEUS_CPU_LIMIT=300m
TEMPO_CPU_REQUEST=50m
TEMPO_CPU_LIMIT=300m
GRAFANA_CPU_REQUEST=20m

# Grafana login. Generated route host, and the core realm of the Keycloak this environment uses.
GRAFANA_ROOT_URL=https://grafana-adsp-uat.apps.aro-01.int.gov.ab.ca
GRAFANA_OAUTH_ENABLED=true
GRAFANA_OAUTH_AUTH_URL=https://access-uat.alberta.ca/auth/realms/core/protocol/openid-connect/auth
GRAFANA_OAUTH_TOKEN_URL=https://access-uat.alberta.ca/auth/realms/core/protocol/openid-connect/token
GRAFANA_OAUTH_API_URL=https://access-uat.alberta.ca/auth/realms/core/protocol/openid-connect/userinfo
GRAFANA_DISABLE_LOGIN_FORM=false
