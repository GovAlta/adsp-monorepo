# RabbitMQ is not applied by Delivery CI (apply-init only); see ../README.md.
# Observed ~60m CPU peak per node. Memory is unchanged: the limit is coupled to
# vm_memory_high_watermark (3Gi) and publishers block when it is reached.
RABBITMQ_CPU_REQUEST=50m
RABBITMQ_CPU_LIMIT=500m

# The init container only removes a stale Erlang cookie, but quota counts the larger of the
# init and main container requests, so it must drop too for the request saving to apply.
RABBITMQ_INIT_CPU_REQUEST=20m
