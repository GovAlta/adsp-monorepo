# The observability stack is applied manually; see ../../observability/README.md.
# Observed <10m CPU per component. Memory is unchanged: Prometheus has OOMKilled at
# 2Gi and the collector limit is paired with memory_limiter.limit_mib.
COLLECTOR_CPU_REQUEST=20m
COLLECTOR_CPU_LIMIT=200m
PROMETHEUS_CPU_REQUEST=50m
PROMETHEUS_CPU_LIMIT=300m
TEMPO_CPU_REQUEST=50m
TEMPO_CPU_LIMIT=300m
GRAFANA_CPU_REQUEST=20m
