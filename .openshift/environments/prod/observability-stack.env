# Applied by .github/workflows/observability.yml; see ../../observability/README.md.
# Resources use the template defaults; only the deployment-specific values are set here.

# Grafana login. Generated route host, and the core realm of the Keycloak this environment uses.
GRAFANA_ROOT_URL=https://grafana-adsp-prod.apps.aro-01.int.gov.ab.ca
GRAFANA_OAUTH_ENABLED=true
GRAFANA_OAUTH_AUTH_URL=https://access.alberta.ca/auth/realms/core/protocol/openid-connect/auth
GRAFANA_OAUTH_TOKEN_URL=https://access.alberta.ca/auth/realms/core/protocol/openid-connect/token
GRAFANA_OAUTH_API_URL=https://access.alberta.ca/auth/realms/core/protocol/openid-connect/userinfo
GRAFANA_DISABLE_LOGIN_FORM=false
