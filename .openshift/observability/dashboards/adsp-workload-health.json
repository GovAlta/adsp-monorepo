          "editorMode": "code",
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) / sum(kube_resourcequota{type=\"hard\", resource=\"limits.cpu\"})",
          "legendFormat": "Namespace CPU %",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Namespace CPU %",
