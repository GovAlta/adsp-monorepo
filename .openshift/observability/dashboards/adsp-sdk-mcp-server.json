        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(count by (service_instance_id) (last_over_time(v8js_memory_heap_used_bytes{service_name=\"adsp-sdk-mcp-server\", service_instance_id=~\"${instance:pipe}\"}[5m])))",
