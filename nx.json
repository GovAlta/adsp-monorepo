{
  "defaultProject": "file-service",
  "generators": {
    "@nrwl/next": {
      "application": {
        "linter": "eslint"
      }
    },
    "@nrwl/nx-plugin": {
      "plugin": {
        "linter": "eslint"
      }
    },
    "@nrwl/nest": {
      "application": {
        "linter": "eslint"
      }
    },
    "@nx/workspace": {
      "library": {
        "linter": "eslint"
      }
    },
    "@nx/web": {
      "application": {
        "linter": "eslint"
      }
    },
    "@nx/cypress": {
      "cypress-project": {
        "linter": "eslint"
      }
    },
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "scss",
        "linter": "eslint",
        "bundler": "webpack"
      },
      "library": {
        "style": "scss",
        "linter": "eslint",
        "unitTestRunner": "jest"
      },
      "storybook-configuration": {
        "linter": "eslint"
      },
      "component": {
        "style": "scss"
      }
    },
    "@nx/express": {
      "application": {
        "linter": "eslint"
      },
      "library": {
        "linter": "eslint"
      }
    },
    "@nx/node": {
      "application": {
        "linter": "eslint"
      },
      "library": {
        "linter": "eslint"
      }
    }
  },
  "plugins": [
    "@nx/dotnet",
    "@nxlv/python",
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/agent-service/**/*",
        "apps/api-docs-app/**/*",
        "apps/builder-app/**/*",
        "apps/cache-service/**/*",
        "apps/calendar-service/**/*",
        "apps/comment-service/**/*",
        "apps/configuration-service/**/*",
        "apps/dashboard-metrics/**/*",
        "apps/directory-service/**/*",
        "apps/event-service/**/*",
        "apps/export-service/**/*",
        "apps/feedback-service/**/*",
        "apps/file-service/**/*",
        "apps/form-admin-app/**/*",
        "apps/form-admin-app-e2e/**/*",
        "apps/form-app/**/*",
        "apps/form-app-e2e/**/*",
        "apps/form-gateway/**/*",
        "apps/form-management-app/**/*",
        "apps/form-service/**/*",
        "apps/notification-service/**/*",
        "apps/pdf-service/**/*",
        "apps/push-service/**/*",
        "apps/sandbox-app/**/*",
        "apps/sandbox-app-e2e/**/*",
        "apps/sharepoint-service/**/*",
        "apps/status-app/**/*",
        "apps/status-app-e2e/**/*",
        "apps/status-service/**/*",
        "apps/subscriber-app/**/*",
        "apps/subscriber-app-e2e/**/*",
        "apps/subscriber-gateway/**/*",
        "apps/task-app/**/*",
        "apps/task-app-e2e/**/*",
        "apps/task-service/**/*",
        "apps/tenant-management-api/**/*",
        "apps/tenant-management-gateway/**/*",
        "apps/tenant-management-webapp/**/*",
        "apps/tenant-management-webapp-e2e/**/*",
        "apps/token-handler/**/*",
        "apps/value-service/**/*",
        "apps/verify-service/**/*",
        "libs/adsp-cli/**/*",
        "libs/adsp-feedback/**/*",
        "libs/adsp-sdk-mcp-server/**/*",
        "libs/adsp-service-sdk/**/*",
        "libs/app-common/**/*",
        "libs/core-common/**/*",
        "libs/data-exchange-standard/**/*",
        "libs/form-editor-common/**/*",
        "libs/job-common/**/*",
        "libs/jsonforms-components/**/*",
        "libs/notification-shared/**/*",
        "libs/stylesheets/scss/**/*",
        "samples/chat-app/**/*",
        "samples/chat-service/**/*",
        "tools/workspace-plugin/**/*"
      ]
    }
  ],
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "!{projectRoot}/Dockerfile", "{workspaceRoot}/eslint.config.mjs"],
      "cache": true
    },
    "e2e": {
      "inputs": ["default", "^production"]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/eslint:lint": {
      "inputs": [
        "default",
        "^default",
        "!{projectRoot}/Dockerfile",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "cache": true
    },
    "@nx/jest:jest": {
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "cache": true,
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "@nx/rollup:rollup": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/webpack:webpack": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/workspace.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tslint.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/babel.config.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "defaultBase": "main",
  "analytics": false
}
