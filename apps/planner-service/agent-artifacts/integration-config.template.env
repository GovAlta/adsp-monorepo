# planner-service Integration Configuration Template
# Copy this file to .env.local and populate with actual values.
# NEVER commit actual values to source control.
# Protected B: see security-classification.yaml for data handling requirements.

# =============================================================================
# INT-001: Anthropic Claude API (BLOCKED — OPEN-001, OPEN-002, OPEN-006)
# DO NOT set these values until legal/privacy approval is obtained.
# =============================================================================
# ANTHROPIC_API_KEY=<secret — from vault; NEVER hardcoded>
# PLANNER_MODEL_VERSION=claude-sonnet-4-5

# =============================================================================
# INT-002: ADSP Configuration Service (BLOCKED — OPEN-004)
# =============================================================================
DIRECTORY_URL=https://directory-service.adsp.alberta.ca

# =============================================================================
# INT-007: ADSP Event Service (RabbitMQ) (STUB — pending platform provisioning)
# =============================================================================
# AMQP_HOST=<rabbitmq host>
# AMQP_USER=<username>
# AMQP_PASSWORD=<secret — from vault; NEVER hardcoded>

# =============================================================================
# INT-008: Keycloak JWT (LIVE — inbound middleware)
# =============================================================================
KEYCLOAK_ROOT_URL=https://access.adsp.alberta.ca
CLIENT_ID=urn:ads:platform:planner-service
# CLIENT_SECRET=<secret — from vault; NEVER hardcoded>

# =============================================================================
# MongoDB (Protected B data store)
# ✓ ASVS:V3.2.1 — URI never logged; env var only
# =============================================================================
# MONGO_URI=<mongodb connection string — from vault; NEVER hardcoded>

# =============================================================================
# Service Configuration
# =============================================================================
PORT=7796
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=50

# Protected B audit signing key
# ✓ CAS:RULE-028 — HMAC signing key for audit chain integrity
# AUDIT_SIGNING_KEY=<secret — from vault; minimum 32 bytes of entropy>
