{
  "name": "script-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/script-service",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run",
        "cwd": "apps/script-service"
      },
      "configurations": {
        "production": {
          "command": "dotnet run --configuration Release"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet format",
        "cwd": "apps/script-service"
      }
    },
    "swagger": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/generated/script-service-swagger/swagger.json"],
      "options": {
        "commands": [
          "dotnet tool restore",
          "dotnet swagger tofile --output libs/generated/script-service-swagger/swagger.json dist/apps/script-service/Adsp.Platform.ScriptService.dll v1"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
