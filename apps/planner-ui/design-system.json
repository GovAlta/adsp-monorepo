{
  "version": "1.0",
  "designSystemVersion": "GoA Design System 2.0",
  "clientStack": "React 18",
  "surface": "private-authenticated",
  "shell": {
    "type": "goa-work-side-menu",
    "cssClass": "goa-work-side-menu",
    "navigation": {
      "areas": [
        {
          "areaId": "planning-workspace",
          "heading": "Planning Workspace",
          "items": [
            { "pageId": "session-dashboard", "label": "My Planning Sessions", "icon": "home", "route": "/sessions" },
            { "pageId": "planning-session", "label": "Active Session", "icon": "chatbubble", "route": "/sessions/:sessionId" }
          ],
          "hiddenItems": [
            { "pageId": "new-session-start", "reason": "Transient start page — accessed via CTA from session-dashboard, not via side-menu" }
          ],
          "childRouteItems": [
            { "pageId": "business-model-review", "parentRoute": "/sessions/:sessionId/model", "visibleInWizardStepProgress": true },
            { "pageId": "hypothesis-review", "parentRoute": "/sessions/:sessionId/hypothesis", "visibleInWizardStepProgress": true },
            { "pageId": "session-export", "parentRoute": "/sessions/:sessionId/export", "visibleInWizardStepProgress": true }
          ]
        },
        {
          "areaId": "administration",
          "heading": "Administration",
          "requiredRoles": ["planner-admin", "tenant-admin"],
          "items": [
            { "pageId": "admin-hub", "label": "Administration", "icon": "settings", "route": "/admin" },
            { "pageId": "pattern-library", "label": "Pattern Library", "icon": "library", "route": "/admin/patterns" },
            { "pageId": "session-history", "label": "Session History", "icon": "time", "route": "/admin/session-history" },
            { "pageId": "audit-log", "label": "Audit Log", "icon": "lock-closed", "route": "/admin/audit-log" },
            { "pageId": "user-management", "label": "User Management", "icon": "people", "route": "/admin/users", "requiredRole": "tenant-admin" }
          ],
          "childRouteItems": [
            { "pageId": "pattern-editor", "parentRoute": "/admin/patterns/:patternId", "note": "Also accessible at /admin/patterns/new for create mode" }
          ]
        }
      ]
    }
  },
  "componentMapping": {
    "session-dashboard": {
      "pageType": "list-index",
      "layout": "single-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "toolbar": {
          "search": "GoabxInput",
          "primaryAction": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Start New Session" }
        },
        "filterDrawer": {
          "component": "GoabxDetails",
          "filters": [
            { "field": "status", "component": "GoabxDropdown", "wrapper": "GoabxFormItem", "items": "GoabxDropdownItem" }
          ]
        },
        "dataTable": {
          "component": "GoabxTable",
          "sortableColumns": ["title", "status", "updatedAt"],
          "sortHeader": "GoabxTableSortHeader",
          "staticHeaders": ["businessProblemSummary", "actions"],
          "statusCell": "GoabxBadge",
          "actionsCell": { "component": "GoabxButton", "props": { "type": "secondary" }, "label": "Resume" }
        },
        "pagination": { "component": "GoabxPagination", "props": { "perPageCount": 20 } },
        "emptyState": { "component": "GoabxCallout", "props": { "type": "information" } },
        "sessionResumeWarning": { "component": "GoabxCallout", "props": { "type": "information", "heading": "Session Idle Warning" }, "condition": "session idle > 7 days" },
        "authExceptionBanner": { "component": "GoabxNotification", "props": { "type": "emergency" }, "condition": "JWT expired / 401" }
      },
      "protectedFields": ["userId", "tenantId"],
      "protectedFieldNote": "userId and tenantId are server-side scoping only — never rendered in UI. businessProblemSummary is display-only read-only text.",
      "loadingState": "GoabxCircularProgress",
      "errorState": "GoabxCallout"
    },
    "new-session-start": {
      "pageType": "start-page",
      "layout": "single-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "alert": { "component": "GoabxCallout", "props": { "type": "information", "heading": "Planning Agent is in test mode" } },
        "description": { "component": "GoabxContainer", "props": { "maxWidth": "740px" } },
        "serviceInfo": { "component": "GoabxContainer" },
        "preparation": { "component": "GoabxContainer", "props": { "maxWidth": "740px" } },
        "sessionTitleForm": {
          "component": "GoabxFormItem",
          "props": { "label": "Session title", "requirement": "required" },
          "input": { "component": "GoabxInput", "props": { "name": "title", "maxLength": 200 } }
        },
        "startAction": {
          "primary": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Start Planning Session" },
          "secondary": { "component": "GoabxButton", "props": { "type": "secondary" }, "label": "Cancel" }
        },
        "mongoErrorBanner": { "component": "GoabxCallout", "props": { "type": "emergency", "heading": "Unable to create session" }, "condition": "POST /sessions returns 503" }
      },
      "protectedFields": [],
      "loadingState": "GoabxCircularProgress",
      "errorState": "GoabxCallout"
    },
    "planning-session": {
      "pageType": "wizard",
      "layout": "two-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "stepProgress": {
          "component": "GoabxContainer",
          "note": "Custom step indicator — no GoabxStepper; build with GoabxContainer + step badges + dividers",
          "steps": ["Describe Problem", "Review Model", "Review Hypothesis", "Export"]
        },
        "primaryPanel": {
          "chatInput": { "component": "GoabxFormItem", "props": { "label": "Your message" }, "textarea": { "component": "GoabxTextArea", "props": { "name": "messageContent", "maxCount": 10000 } } },
          "sendButton": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Send Message", "disabledWhenStub": true },
          "integrationPendingBanner": { "component": "IntegrationPendingBanner", "props": { "intId": "INT-001" } },
          "llmUnavailableError": { "component": "GoabxCallout", "props": { "type": "emergency" }, "condition": "POST /messages 503" },
          "rateLimitBanner": { "component": "GoabxCallout", "props": { "type": "emergency" }, "condition": "POST /messages 429" },
          "rateLimitWarning": { "component": "GoabxCallout", "props": { "type": "important" }, "condition": "80% of rate limit" }
        },
        "sidePanel": {
          "businessModelStatusCard": {
            "component": "GoabxContainer",
            "confidenceBadge": "ConfidenceBadge",
            "viewModelButton": { "component": "GoabxButton", "props": { "type": "tertiary" }, "label": "View Business Model" },
            "incompleteWarning": { "component": "GoabxCallout", "props": { "type": "information" } }
          },
          "specialistConsultationPanel": {
            "component": "GoabxContainer",
            "specialistButtons": { "component": "GoabxButton", "props": { "type": "secondary", "disabled": "whenStub" } }
          }
        },
        "contextSummary": { "component": "GoabxCallout", "props": { "type": "information", "heading": "Welcome back" }, "condition": "session re-entry" },
        "staleSummary": { "component": "GoabxCallout", "props": { "type": "important", "heading": "Extended context recap" }, "condition": "idle > 7 days" },
        "stepNavigation": {
          "back": { "component": "GoabxButton", "props": { "type": "secondary" }, "label": "Back to Session List" },
          "continue": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Review Business Model" },
          "cancel": { "component": "GoabxButton", "props": { "type": "tertiary" }, "label": "Save and Exit" }
        }
      },
      "protectedFields": ["conversationMessage.content", "planningSession.userId", "planningSession.tenantId"],
      "protectedFieldNote": "Message content in Protected B — in-memory React state only, no localStorage. userId/tenantId not rendered in client UI.",
      "loadingState": "GoabxCircularProgress",
      "errorState": "GoabxCallout"
    },
    "business-model-review": {
      "pageType": "detail-view",
      "layout": "single-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "itemHeading": {
          "component": "GoabxContainer",
          "heading": "h1 Business Model",
          "statusBadge": { "component": "ConfidenceBadge", "note": "success>=70, warning 50-69, emergency<50" }
        },
        "keyFields": {
          "problemSummary": { "component": "MaskedField", "props": { "fieldName": "businessModel.problemSummary" }, "annotation": "ASVS:V-8.3.1 ATIA s.23" },
          "confidenceScore": { "component": "GoabxFormItem", "props": { "label": "Confidence Score", "readonly": true } },
          "extractionDate": { "component": "GoabxFormItem", "props": { "label": "Extraction Date", "readonly": true } },
          "conceptCount": { "component": "GoabxFormItem", "props": { "label": "Concept Count", "readonly": true } }
        },
        "contextActions": {
          "confirm": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Confirm Business Model" },
          "return": { "component": "GoabxButton", "props": { "type": "secondary" }, "label": "Return to Planning Conversation" }
        },
        "tabs": {
          "component": "div",
          "props": { "role": "tablist" },
          "note": "No GoabxTabs component — use div[role=tablist] + aria-controls pattern",
          "tabs": [
            { "id": "actors", "label": "Actors", "table": "GoabxTable", "inlineEdit": { "component": "GoabxDropdown", "name": "conceptType", "items": "GoabxDropdownItem" } },
            { "id": "processes", "label": "Processes", "table": "GoabxTable", "inlineEdit": { "component": "GoabxDropdown", "name": "conceptType", "items": "GoabxDropdownItem" } },
            { "id": "systems", "label": "Systems", "table": "GoabxTable", "inlineEdit": { "component": "GoabxDropdown", "name": "conceptType", "items": "GoabxDropdownItem" } }
          ]
        },
        "warnings": {
          "confidenceLow": { "component": "GoabxCallout", "props": { "type": "emergency" } },
          "confidenceModerate": { "component": "GoabxCallout", "props": { "type": "important" } },
          "confidenceHigh": { "component": "GoabxCallout", "props": { "type": "success" } },
          "emptyModel": { "component": "GoabxCallout", "props": { "type": "information" } }
        },
        "policyNotice": { "component": "GoabxCallout", "props": { "type": "information" }, "text": "ATIA s.23 Protected B notice" }
      },
      "protectedFields": ["businessModel.problemSummary", "businessConcept.name", "businessConcept.description", "businessConcept.sourceText"],
      "loadingState": "GoabxCircularProgress",
      "errorState": "GoabxCallout"
    },
    "hypothesis-review": {
      "pageType": "wizard-step-review",
      "layout": "single-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "reviewSections": {
          "proposedHypothesis": {
            "heading": "Proposed Solution Hypothesis",
            "fields": {
              "summary": { "component": "MaskedField", "props": { "fieldName": "solutionHypothesis.summary" }, "annotation": "ASVS:V-8.3.1 ATIA s.23" },
              "status": { "component": "GoabxFormItem", "props": { "label": "Status", "readonly": true } },
              "version": { "component": "GoabxFormItem", "props": { "label": "Hypothesis Version", "readonly": true } },
              "patternId": { "component": "GoabxFormItem", "props": { "label": "Matched Business Pattern", "readonly": true } }
            }
          },
          "planningAgentReasoning": {
            "component": "GoabxDetails",
            "props": { "heading": "Planning Agent Reasoning", "open": false },
            "reasoning": { "component": "MaskedField", "props": { "fieldName": "solutionHypothesis.reasoning" }, "annotation": "ASVS:V-8.3.1 ATIA s.23" }
          }
        },
        "submitAction": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Accept Hypothesis" },
        "optionalInput": {
          "label": "Revision Request",
          "textarea": { "component": "GoabxFormItem", "props": { "label": "Revision Request" }, "input": { "component": "GoabxTextArea", "name": "revisionRequest" } },
          "submit": { "component": "GoabxButton", "props": { "type": "secondary" }, "label": "Request Revision" }
        },
        "policyNotice": { "component": "GoabxCallout", "props": { "type": "information" }, "text": "ATIA s.23 Protected B deliberative information notice" },
        "warnings": {
          "lockedNoHypothesis": { "component": "GoabxCallout", "props": { "type": "information" } },
          "int001StubPending": { "component": "GoabxCallout", "props": { "type": "information" } },
          "hypothesisSuperseded": { "component": "GoabxCallout", "props": { "type": "information" } }
        },
        "integrationPendingBanner": { "component": "IntegrationPendingBanner", "props": { "intId": "INT-001" } }
      },
      "protectedFields": ["solutionHypothesis.summary", "solutionHypothesis.reasoning"],
      "loadingState": "GoabxCircularProgress",
      "errorState": "GoabxCallout"
    },
    "session-export": {
      "pageType": "detail-view",
      "layout": "single-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "itemHeading": {
          "heading": "h1 Session Plan Export",
          "statusBadge": { "component": "GoabxBadge", "note": "information=active, warning=paused, success=completed, emergency=archived" }
        },
        "keyFields": {
          "title": { "component": "MaskedField", "props": { "fieldName": "planningSession.title" }, "annotation": "ASVS:V-8.3.1 ATIA s.23" },
          "businessProblemSummary": { "component": "MaskedField", "props": { "fieldName": "planningSession.businessProblemSummary" }, "annotation": "ASVS:V-8.3.1 ATIA s.23" },
          "hypothesisStatus": { "component": "GoabxFormItem", "props": { "label": "Hypothesis Status", "readonly": true } },
          "createdAt": { "component": "GoabxFormItem", "props": { "label": "Created Date", "readonly": true } },
          "updatedAt": { "component": "GoabxFormItem", "props": { "label": "Last Updated", "readonly": true } }
        },
        "contextActions": {
          "download": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Download JSON Export", "disabledWhen": "hypothesisStatus !== accepted" },
          "back": { "component": "GoabxButton", "props": { "type": "secondary" }, "label": "Back to Planning Session" }
        },
        "tabs": {
          "component": "div",
          "props": { "role": "tablist" },
          "tabs": [
            { "id": "business-model-summary", "label": "Business Model Summary", "content": "GoabxFormItem read-only fields" },
            { "id": "hypothesis-summary", "label": "Hypothesis Summary", "maskedFields": ["solutionHypothesis.summary", "solutionHypothesis.reasoning"], "component": "MaskedField" },
            { "id": "specialist-consultations", "label": "Specialist Consultations", "content": "GoabxTable read-only" }
          ]
        },
        "emptyState": { "component": "GoabxCallout", "props": { "type": "information" }, "condition": "hypothesisStatus !== accepted" },
        "policyNotice": { "component": "GoabxCallout", "props": { "type": "information" }, "text": "ATIA s.23 + POPA s.17 Protected B notice" }
      },
      "protectedFields": ["planningSession.title", "planningSession.businessProblemSummary", "solutionHypothesis.summary", "solutionHypothesis.reasoning", "sessionExport.userId", "sessionExport.tenantId"],
      "loadingState": "GoabxCircularProgress",
      "errorState": "GoabxCallout"
    },
    "admin-hub": {
      "pageType": "section-hub",
      "layout": "single-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "hubIntro": { "component": "GoabxContainer", "heading": "h1 Administration" },
        "sectionTiles": {
          "layout": { "component": "GoabxGrid", "props": { "gap": "m", "minChildWidth": "260px" } },
          "tiles": [
            { "tileId": "tile-pattern-library", "component": "GoabxContainer", "icon": "GoabxIconButton library", "heading": "h2 Pattern Library", "statsBadge": "GoabxBadge type=information from listPatterns.total", "cta": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Manage Patterns" } },
            { "tileId": "tile-session-history", "component": "GoabxContainer", "icon": "GoabxIconButton time", "heading": "h2 Session History", "statsBadge": "GoabxBadge type=information from listSessions.total", "cta": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "View History" } },
            { "tileId": "tile-audit-log", "component": "GoabxContainer", "icon": "GoabxIconButton lock-closed", "heading": "h2 Audit Log", "statsBadge": "GoabxBadge type=information from listAuditEvents.total", "cta": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "View Audit Log" } },
            { "tileId": "tile-user-management", "component": "GoabxContainer", "requiredRole": "tenant-admin", "icon": "GoabxIconButton people", "heading": "h2 User Management", "cta": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Manage Users" } }
          ]
        }
      },
      "protectedFields": [],
      "loadingState": "GoabxCircularProgress",
      "errorState": "GoabxCallout"
    },
    "pattern-library": {
      "pageType": "list-index",
      "layout": "single-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "toolbar": {
          "search": "GoabxInput placeholder=Search patterns by name or keyword",
          "resultCountBadge": "GoabxBadge type=midtone",
          "primaryAction": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Create Pattern" }
        },
        "filterDrawer": {
          "component": "GoabxDetails",
          "props": { "heading": "Filter Patterns", "open": false },
          "filters": [
            { "field": "status", "component": "GoabxDropdown", "wrapper": "GoabxFormItem", "items": "GoabxDropdownItem (all/active/inactive)" },
            { "field": "dateModifiedRange", "components": ["GoabxFormItem", "GoabxDatePicker from", "GoabxDatePicker to"] }
          ]
        },
        "dataTable": {
          "component": "GoabxTable",
          "sortableColumns": ["name", "lastModified", "matchCount"],
          "sortHeader": "GoabxTableSortHeader",
          "staticHeaders": ["status"],
          "statusCell": "GoabxBadge success=active midtone=inactive",
          "nameCell": "link to pattern-editor"
        },
        "pagination": { "component": "GoabxPagination", "props": { "perPageCount": 20 } },
        "emptyState": { "component": "GoabxCallout", "props": { "type": "information" }, "cta": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Create Pattern" } },
        "int002StubBanner": { "component": "GoabxCallout", "props": { "type": "important", "heading": "Pattern data is temporarily unavailable" }, "condition": "INT-002 returns 503" }
      },
      "protectedFields": [],
      "loadingState": "GoabxCircularProgress",
      "errorState": "GoabxCallout"
    },
    "pattern-editor": {
      "pageType": "edit-form",
      "layout": "single-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "formIntro": { "component": "GoabxContainer", "heading": "h1 Create Business Pattern (create) / Edit Business Pattern (edit)" },
        "formFields": {
          "name": { "component": "GoabxFormItem", "props": { "label": "Pattern Name", "requirement": "required" }, "input": { "component": "GoabxInput", "props": { "name": "name", "maxLength": 120 } } },
          "description": { "component": "GoabxFormItem", "props": { "label": "Description", "requirement": "required" }, "input": { "component": "GoabxTextArea", "props": { "name": "description", "maxCount": 2000 } } },
          "status": { "component": "GoabxFormItem", "props": { "label": "Status", "requirement": "required" }, "input": { "component": "GoabxDropdown", "props": { "name": "status", "value": "active" }, "items": "GoabxDropdownItem (active/inactive)" } },
          "keywords": { "component": "GoabxFormItem", "props": { "label": "Keywords" }, "input": { "component": "GoabxInput", "props": { "name": "keywords" }, "note": "Custom tag-input pattern built on GoabxInput + chip display" } },
          "serviceAffinity": { "component": "GoabxFormItem", "props": { "label": "Service Affinity" }, "input": { "component": "GoabxDropdown", "props": { "name": "serviceAffinity", "multiSelect": true }, "items": "GoabxDropdownItem per ADSP service" } },
          "matchThreshold": { "component": "GoabxFormItem", "props": { "label": "Match Threshold", "requirement": "required" }, "input": { "component": "GoabxInput", "props": { "name": "matchThreshold", "type": "number", "min": 0, "max": 100 } } }
        },
        "formActions": {
          "save": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Save Pattern" },
          "cancel": { "component": "GoabxButton", "props": { "type": "secondary" }, "label": "Cancel" },
          "deactivate": { "component": "GoabxButton", "props": { "type": "secondary", "variant": "destructive" }, "label": "Deactivate Pattern", "condition": "editMode only" }
        },
        "errorBanner": { "component": "GoabxCallout", "props": { "type": "emergency" }, "condition": "400/413/422/503" }
      },
      "protectedFields": [],
      "loadingState": "GoabxCircularProgress",
      "errorState": "GoabxCallout"
    },
    "session-history": {
      "pageType": "report-results",
      "layout": "single-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "filterControls": {
          "component": "GoabxDetails",
          "props": { "heading": "Filters", "open": true },
          "filters": [
            { "field": "dateRange", "components": ["GoabxFormItem", "GoabxDatePicker from", "GoabxDatePicker to"] },
            { "field": "userRef", "component": "GoabxDropdown", "wrapper": "GoabxFormItem", "note": "Searchable; selection resolved to opaque userRef — FAC-S5-024: not raw POPA s.17 userId in URL" },
            { "field": "status", "component": "GoabxDropdown", "wrapper": "GoabxFormItem", "items": "GoabxDropdownItem (active/completed/archived)" }
          ]
        },
        "runAction": { "component": "GoabxButton", "props": { "type": "primary" }, "label": "Apply Filters" },
        "resultsTable": {
          "component": "GoabxTable",
          "sortableColumns": ["ownerDisplayName", "status", "createdAt", "lastActivityAt"],
          "sortHeader": "GoabxTableSortHeader",
          "staticHeaders": ["id", "businessProblemSummary"],
          "ownerDisplayNameNote": "// ASVS:V-8.3.1 // CAS:RULE-017 — raw userId masked to displayName; never rendered",
          "statusCell": "GoabxBadge success=active information=completed midtone=archived"
        },
        "rowDetailPanel": {
          "component": "GoabxContainer",
          "trigger": "row-click expand",
          "adminAnnotation": { "component": "GoabxFormItem", "props": { "label": "Governance Note", "roleGating": "planner-admin/tenant-admin" }, "input": { "component": "GoabxTextArea", "name": "adminAnnotation" } }
        },
        "exportAction": { "component": "GoabxButton", "props": { "type": "secondary" }, "label": "Export Results" },
        "pagination": { "component": "GoabxPagination", "props": { "perPageCount": 20 } },
        "emptyState": { "component": "GoabxCallout", "props": { "type": "information" } }
      },
      "protectedFields": ["planningSession.userId"],
      "protectedFieldNote": "userId masked to ownerDisplayName — never rendered raw. // ASVS:V-8.3.1 // CAS:RULE-017 annotation required on ownerDisplayName render.",
      "loadingState": "GoabxCircularProgress",
      "errorState": "GoabxCallout"
    },
    "audit-log": {
      "pageType": "report-results",
      "layout": "single-column",
      "primaryContainer": "GoabxContainer",
      "sections": {
        "integrityBanner": {
          "component": "HmacStatusBanner",
          "note": "Custom shared component — wraps GoabxCallout. verified:true → type=success; verified:false → type=emergency with ADSP Support CTA",
          "loadedBy": "verifyAuditChain on page mount — before table data fetch"
        },
        "filterControls": {
          "component": "GoabxDetails",
          "props": { "heading": "Filters", "open": true },
          "filters": [
            { "field": "resourceType", "component": "GoabxDropdown", "wrapper": "GoabxFormItem", "props": { "multiSelect": true }, "items": "GoabxDropdownItem per action type" },
            { "field": "actorId", "component": "GoabxDropdown", "wrapper": "GoabxFormItem", "note": "Displayed as displayName; actorId is Protected A GoA employee userId per OpenAPI — standard listAuditEvents query param" },
            { "field": "dateRange", "components": ["GoabxFormItem", "GoabxDatePicker since", "GoabxDatePicker until"] }
          ]
        },
