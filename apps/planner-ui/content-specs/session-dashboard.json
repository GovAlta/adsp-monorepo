    "tcIds": ["TC-001", "TC-002", "TC-008", "TC-011", "TC-012", "TC-014", "TC-019", "TC-037", "TC-039", "TC-041", "TC-042", "TC-050", "TC-055", "TC-056", "TC-057", "TC-080"],
    "ucIds": ["UC-001", "UC-006", "UC-009"]
  },
  "securityNotes": {
    "classificationLevel": "Protected B",
    "protectedFields": ["userId", "tenantId"],
